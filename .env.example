# ---------------------------------------------------------------------------
# Azure AI Foundry - Verbindungsdaten
# Kopiere diese Datei nach ".env" und fuelle die Werte aus.
# Alle Beispiele lesen ausschliesslich aus common/config.py.
# ---------------------------------------------------------------------------

# Endpoint deines Foundry-*Projekts* (Portal -> Overview -> "Azure AI Foundry project endpoint")
# Form: https://<resource>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_PROJECT_ENDPOINT=https://my-resource.services.ai.azure.com/api/projects/my-project

# Name eines Chat-Deployments in diesem Projekt (NICHT der Modellname aus dem Katalog,
# sondern der Deployment-Name, den du beim Deployen vergeben hast).
MODEL_DEPLOYMENT_NAME=gpt-5.6-sol
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# Eigenes Modell fuer das klassische Agent Service (03_agents/, 05_apps/, ...).
# Dort laeuft gpt-5.6-sol nicht: das Agent Service sendet intern ein `top_p`, das
# die neuesten Modelle ablehnen. Und selbst aeltere GPT-5-Modelle unterstuetzen
# dort nur "Responses API compatible tools" - also Code Interpreter, File Search
# und MCP, aber NICHT OpenAPI, Bing Grounding, Connected Agents oder AI Search.
# gpt-4o ist das Modell, mit dem alle Agent-Beispiele durchlaufen.
# Nur Code Interpreter / File Search / MCP im Einsatz? Dann geht auch gpt-5.4.
AGENT_MODEL_DEPLOYMENT_NAME=gpt-4o

# Reasoning-Modell fuer 01_basics/08. gpt-5.6-sol ist selbst eines, deshalb
# per Default dasselbe Deployment.
REASONING_DEPLOYMENT_NAME=gpt-5.6-sol

# API-Version fuer den OpenAI-kompatiblen Client.
# Nur relevant fuer azure-ai-projects 1.x. Unter 2.x zeigt der Client auf
# /openai/v1 und ist versionslos - der Wert wird dann ignoriert.
OPENAI_API_VERSION=2024-10-21

# ---------------------------------------------------------------------------
# Authentifizierung
# Bevorzugt: keine Keys. `az login` genuegt, DefaultAzureCredential holt sich das Token.
# Fallback fuer CI / Container: Service Principal.
# ---------------------------------------------------------------------------
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Nur falls du bewusst mit Key statt Entra ID arbeiten willst (siehe common/clients.py):
# AZURE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Optional: direkter Azure-OpenAI-Endpoint (ohne Project-Layer)
# ---------------------------------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com

# ---------------------------------------------------------------------------
# RAG: Azure AI Search
# ---------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://my-search.search.windows.net
AZURE_SEARCH_INDEX_NAME=foundry-demo-index
# AZURE_SEARCH_API_KEY=            # optional, sonst Entra ID
# Name der Search-Connection im Foundry-Projekt (fuer das AzureAISearchTool des Agents).
# Der Index braucht einen integrierten Vectorizer - siehe 04_rag/01_build_index.py.
AZURE_SEARCH_CONNECTION_NAME=my-search-connection

# ---------------------------------------------------------------------------
# Grounding with Bing Search (eigene Ressource, im Projekt als Connection verknuepft).
# Leer lassen -> 03_agents/06 ueberspringt sich sauber.
# ---------------------------------------------------------------------------
BING_CONNECTION_NAME=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Leer lassen -> 07_observability holt den String automatisch aus dem Projekt.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=true
